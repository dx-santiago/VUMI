# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local runtime data (may contain DVR, storage, or file metadata)
/spool/
*.partial.mp4
job_*.json
*.log
/config.json

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json
.pypirc

# Local databases and operating-system files
*.sqlite
*.sqlite3
Thumbs.db
Desktop.ini
.DS_Store

# Editors and local tooling
.idea/
.vscode/
.codex-remote-audit/

# Development-only files intentionally excluded from this release
/tests/
/requirements-dev.txt
